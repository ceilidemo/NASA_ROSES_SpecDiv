# Coefficient Heatmap Annotated with Adjusted R² Values
# -------------------------------------------------------------------------------------
# 1. Extract and merge R-squared metrics into the heatmap dataset
r2_data <- non_null_glances %>%
select(Response_Variable, adj.r.squared, p.value) %>%
mutate(model_label = paste0(Response_Variable, "\n(Adj R² = ", round(adj.r.squared, 2), ", p = ", format.pval(p.value, digits = 2), ")"))
