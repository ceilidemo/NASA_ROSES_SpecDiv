library(car)      # For Anova, VIF, and added-variable plots
library(visreg)   # For clean partial effect visualization
# 1. Fit the top-ranked controlled model from your dredge results
top_model <- lm(Beta_PD_qDTM ~ pct_visible_tree_cover + Ht_beta_BrightVectorNorm, data = subset_data)
# 2. View model summary, coefficients, and overall R-squared
summary(top_model)
# 3. Check multicollinearity (VIF should ideally be close to 1 since they were only weakly correlated)
vif(top_model)
# 4. Run ANOVA to evaluate unique sums of squares
Anova(top_model, type = "II")
# 5. PLOTTING OPTION A: Added-Variable Plots (Partial Regression Plots)
# These show the isolated relationship of each predictor holding the other constant,
# with the slope matching the exact regression coefficient in the model.
par(mfrow = c(1, 2))
avPlots(top_model, main = "Added-Variable Plots (Controlled for Tree Cover)")
par(mfrow = c(1, 1))
# 6. PLOTTING OPTION B: Conditional Partial Effect Plot using visreg
# This plots the predicted response against spectral entropy (Ht)
# while holding percent visible tree cover constant at its median.
visreg(top_model, "Ht_beta_BrightVectorNorm",
type = "conditional",
fill = list(col = "grey80"),
line = list(col = "#b2182b"),
points = list(col = "#2b5c8f", pch = 16, alpha = 0.7),
xlab = "EMIT Spectral Entropy / Evenness (Ht)",
ylab = "Phylogenetic Synthesis Diversity (Controlled)",
main = "Partial Effect of Spectral Diversity on Phylogenetic Diversity")
