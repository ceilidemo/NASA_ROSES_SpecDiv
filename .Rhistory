if (length(qdtm_pred_cols) == 1) {
formula_str <- paste(target_metric, "~", qdtm_pred_cols)
fit <- lm(as.formula(formula_str), data = modeling_df)
coef_df <- data.frame(
neon_metric = target_metric,
variable = names(coef(fit))[-1],
coefficient = coef(fit)[-1]
)
isolated_results_list[[target_metric]] <- coef_df
} else {
# If 2+ predictors, use Elastic Net
x_mat <- as.matrix(modeling_df %>% select(all_of(qdtm_pred_cols)))
