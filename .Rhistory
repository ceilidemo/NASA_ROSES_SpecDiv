library(dplyr)
library(tidyr)
library(lavaan)
# 1. Define your predictor and response pools
spectral_predictors <- grep("BrightVectorNorm$", names(emit_wide), value = TRUE)
# Grab all plant diversity response columns (both phylogenetic and functional, e.g., starting with Beta_)
plant_responses <- grep("^Beta_", names(model_data), value = TRUE)
mediator_col <- "pct_visible_tree_cover"
# 2. Initialize a storage list for loop results
sem_results_list <- list()
# 3. Loop through every combination of plant response and spectral predictor
for (resp in plant_responses) {
for (spec in spectral_predictors) {
# Subset and clean complete cases for this specific pair
df_pair <- model_data %>%
select(all_of(c(resp, mediator_col, spec))) %>%
drop_na()
if (nrow(df_pair) < 15) next # Skip if sample size is too small
# Scale variables internally to ensure numerical stability during optimization
df_scaled <- df_pair %>%
mutate(
Y_scaled = scale(.data[[resp]]),
M_scaled = scale(.data[[mediator_col]]),
X_scaled = scale(.data[[spec]])
)
# Construct the dynamic path model string
model_str <- '
M_scaled ~ a * X_scaled
Y_scaled ~ c_prime * X_scaled + b * M_scaled
indirect := a * b
total := c_prime + (a * b)
'
# Fit the SEM safely using tryCatch to handle any convergence issues
fit <- tryCatch({
sem(model_str, data = df_scaled, estimator = "MLR", warn = FALSE)
}, error = function(e) { NULL })
# Extract parameter estimates if the model converged successfully
if (!is.null(fit) && inspect(fit, "converged")) {
params <- parameterEstimates(fit, standardized = TRUE)
sem_results_list[[paste(resp, spec, sep = "___")]] <- data.frame(
Response   = resp,
Predictor  = spec,
a_est      = params$est[params$label == "a"],
a_pval     = params$pvalue[params$label == "a"],
c_prime_est= params$est[params$label == "c_prime"],
c_prime_pval= params$pvalue[params$label == "c_prime"],
b_est      = params$est[params$label == "b"],
b_pval     = params$pvalue[params$label == "b"],
indirect_est= params$est[params$label == "indirect"],
indirect_pval= params$pvalue[params$label == "indirect"],
std_c_prime= params$std.all[params$label == "c_prime"]
)
}
}
}
# 4. Bind all model summaries into a single comprehensive data frame
master_sem_summary <- bind_rows(sem_results_list)
# 5. View top models sorted by direct effect significance or strength
head(master_sem_summary %>% arrange(c_prime_pval), 15)
# Filter the master summary specifically for phylogenetic diversity metrics
pd_sem_summary <- master_sem_summary %>%
filter(grepl("_PD$", Response) | grepl("_PD_", Response)) %>%
arrange(Response, c_prime_pval)
# View the filtered PD table
print(pd_sem_summary)
library(dplyr)
library(ggplot2)
# 1. Prepare and filter your master results for easy plotting
plot_data <- master_sem_summary %>%
filter(grepl("_PD$", Response) | grepl("_PD_", Response)) %>%
mutate(
Metric_Type = case_when(
grepl("Evenness", Response) ~ "Phylogenetic Evenness",
grepl("Dispersion", Response) ~ "Phylogenetic Dispersion",
grepl("PD_qDTM", Response) ~ "Phylogenetic Synthesis (qDTM)",
TRUE ~ Response
),
Significant_Direct = c_prime_pval < 0.05
)
# 2. Create a faceted coefficient plot comparing Direct vs. Indirect effects across metrics
ggplot(plot_data, aes(x = reorder(Predictor, c_prime_est), y = c_prime_est, color = Significant_Direct)) +
geom_hline(yintercept = 0, linetype = "dashed", color = "grey50") +
geom_point(size = 3) +
geom_errorbar(aes(ymin = c_prime_est - 1.96 * 0.1, ymax = c_prime_est + 1.96 * 0.1), width = 0.2) + # Approximate CI or use standard errors if saved
coord_flip() +
facet_wrap(~ Metric_Type, scales = "free_y") +
scale_color_manual(values = c("FALSE" = "#7f7f7f", "TRUE" = "#2b5c8f")) +
labs(
title = "Direct Effects of EMIT Spectral Predictors on Phylogenetic Diversity",
subtitle = "Controlled for woody canopy cover mediation in structural equation models",
x = "EMIT Spectral Predictor",
y = "Standardized Direct Effect (c' path)",
color = "p < 0.05"
) +
theme_minimal(base_size = 11) +
theme(legend.position = "bottom")
