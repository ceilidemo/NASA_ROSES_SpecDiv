qdtm_pred_cols <- grep("qDTM", predictor_cols, value = TRUE, ignore.case = TRUE)
message(sprintf("Retained %d qDTM-specific predictor(s): %s",
length(qdtm_pred_cols), paste(qdtm_pred_cols, collapse = ", ")))
# 2. Target only the qDTM NEON beta metrics
qdtm_beta_cols <- grep("qDTM", names(combined_data), value = TRUE)
# 3. Run Elastic Net using only qDTM predictors
isolated_results_list <- list()
set.seed(42)
for (target_metric in qdtm_beta_cols) {
modeling_df <- combined_data %>%
select(siteID, all_of(target_metric), all_of(qdtm_pred_cols)) %>%
na.omit()
if (nrow(modeling_df) > 10) {
x_mat <- as.matrix(modeling_df %>% select(all_of(qdtm_pred_cols)))
y_vec <- modeling_df[[target_metric]]
if (length(unique(y_vec)) > 1 && ncol(x_mat) > 0) {
cv_enet <- cv.glmnet(x_mat, y_vec, alpha = 0.5, nfolds = 10)
enet_coefs <- coef(cv_enet, s = "lambda.min")
coef_df <- data.frame(
neon_metric = target_metric,
variable = rownames(enet_coefs),
coefficient = as.vector(enet_coefs)
) %>%
filter(variable != "(Intercept)", coefficient != 0)
if (nrow(coef_df) > 0) {
isolated_results_list[[target_metric]] <- coef_df
}
}
}
}
