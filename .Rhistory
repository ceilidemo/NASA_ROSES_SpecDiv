raw_predictors <- c("raw_dispersion", "raw_evenness", "raw_sum_squares")
response_vars <- c("Alpha_FD_qDTM", "Beta_FD_qDTM", "Alpha_PD_qDTM", "Beta_PD_qDTM",
"Alpha_Richness_FD", "Total_Richness_FD", "Alpha_Dispersion_FD",
"Beta_Dispersion_FD", "Alpha_Evenness_FD", "Beta_Evenness_FD",
"Alpha_Richness_PD", "Total_Richness_PD", "Alpha_Dispersion_PD",
"Beta_Dispersion_PD", "Alpha_Evenness_PD", "Beta_Evenness_PD")
grid_pairs <- expand_grid(Metric = response_vars, Predictor = raw_predictors)
model_results <- grid_pairs %>%
rowwise() %>%
mutate(
model = list(tryCatch(lm(as.formula(paste(Metric, "~", Predictor)), data = dat), error = function(e) NULL)),
glance_mod = list(if (!is.null(model)) glance(model) else NULL),
r2 = if (!is.null(glance_mod)) glance_mod$r.squared else NA_real_,
p_val = if (!is.null(glance_mod)) glance_mod$p.value else NA_real_
) %>%
ungroup() %>%
filter(!is.na(p_val))
sig_models <- model_results %>% filter(p_val < 0.05)
plot_data_list <- map(1:nrow(sig_models), function(i) {
m <- sig_models$Metric[i]
p <- sig_models$Predictor[i]
r2_val <- sig_models$r2[i]
p_val <- sig_models$p_val[i]
dat %>%
select(site, Metric_Val = all_of(m), Predictor_Val = all_of(p)) %>%
drop_na() %>%
mutate(
Metric_Name = m,
Predictor_Name = p,
Facet_Label = paste0(m, " ~ ", p, "\n(R² = ", round(r2_val, 2), ", p = ", format.pval(p_val, digits = 2), ")")
)
})
sig_plot_data <- bind_rows(plot_data_list)
p_faceted <- ggplot(sig_plot_data, aes(x = Predictor_Val, y = Metric_Val)) +
geom_point(aes(color = site), size = 2.5, alpha = 0.8, show.legend = FALSE) +
geom_smooth(method = "lm", color = "darkslategray", linetype = "dashed", se = TRUE, linewidth = 0.8) +
facet_wrap(~ Facet_Label, scales = "free", ncol = 3) +
labs(
title = "Significant Linear Relationships: Raw Spectral Metrics vs. Plant Metrics",
x = "Raw Spectral Predictor Value",
y = "Plant Biodiversity Metric Value"
) +
theme_bw(base_size = 10) +
theme(
strip.text = element_text(face = "bold", size = 7.5),
axis.text = element_text(size = 8),
plot.title = element_text(face = "bold", size = 11)
)
print(p_faceted)
