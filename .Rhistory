View(topdown_qdtm_master)
# -------------------------------------------------------------------------------------
# 5. Aggregate and Bind Site-Level Results Across All NEON Sites
# -------------------------------------------------------------------------------------
site_results_list <- map(sites_to_keep, function(s_id) {
s_df <- topdown_keyed %>% filter(siteID == s_id)
run_topdown_qdtm_site(
site_df                  = s_df,
site_id                  = s_id,
trait_cols               = trait_cols,
phylo_tree               = tre$scenario.3,
q                        = 1,
functional_allowed_sites = functional_sites
)
})
write.csv(topdown_qdtm_master, "NEON_PlantDiv/new_data_out/NEON_TopDown_qDTM_Results_2024.csv", row.names = FALSE)
save(topdown_qdtm_master, tre, file = "data_out/new_data_out/topdown_qdtm_results_2024.RData")
