library(ggplot2)
library(dplyr)
library(tidyr)
library(glmnet)
# Store individual, publication-ready ggplot objects in a named list
individual_plots <- list()
set.seed(42)
for (target_metric in names(lasso_results_list)) {
modeling_df <- combined_data %>%
select(siteID, all_of(target_metric), all_of(predictor_cols)) %>%
na.omit()
if (nrow(modeling_df) > 10) {
x_mat <- as.matrix(modeling_df %>% select(all_of(predictor_cols)))
y_vec <- modeling_df[[target_metric]]
cv_lasso <- cv.glmnet(x_mat, y_vec, alpha = 1, nfolds = 10)
y_pred <- as.vector(predict(cv_lasso, newx = x_mat, s = "lambda.min"))
# Calculate key performance metrics
r2_val <- as.numeric(cor(y_vec, y_pred)^2)
rmse_val <- sqrt(mean((y_vec - y_pred)^2))
n_obs <- length(y_vec)
plot_df <- data.frame(Actual = y_vec, Predicted = y_pred)
# Build a polished individual plot
p <- ggplot(plot_df, aes(x = Actual, y = Predicted)) +
geom_point(color = "steelblue4", size = 3, alpha = 0.85, stroke = 0.3, shape = 21, fill = "skyblue1") +
geom_abline(slope = 1, intercept = 0, color = "gray40", linetype = "dashed", linewidth = 0.8) +
geom_smooth(method = "lm", se = FALSE, color = "darkorange2", linetype = "solid", linewidth = 0.8) +
annotate("text",
x = -Inf, y = Inf, hjust = -0.05, vjust = 1.5,
label = paste0("R² = ", sprintf("%.2f", r2_val), "\nRMSE = ", sprintf("%.4f", rmse_val), "\nn = ", n_obs),
fontface = "bold", size = 4, color = "gray20") +
theme_minimal(base_size = 12) +
labs(
title = paste0("Model Performance: ", target_metric),
subtitle = "Full-feature LASSO (EMIT + GEDI predictors)",
x = "Observed (NEON)",
y = "Predicted (LASSO)"
) +
theme(
plot.title = element_text(face = "bold", size = 13, color = "gray10"),
plot.subtitle = element_text(size = 10, color = "gray50", margin = margin(b = 10)),
panel.grid.minor = element_blank(),
panel.grid.major = element_line(color = "gray90"),
plot.margin = margin(15, 15, 15, 15)
)
individual_plots[[target_metric]] <- p
}
}
