library(dplyr)
library(tidyr)
library(MuMIn)
# 1. Select a strong canopy structural metric from your site data (e.g., mean_canopy_height_site)
canopy_col <- "mean_canopy_height_site"
# 2. Filter for phylogenetic response variables specifically
pd_response_cols <- grep("^Beta_.*PD", names(neon), value = TRUE)
spectral_predictors <- grep("BrightVectorNorm$", names(emit_wide), value = TRUE)
# 3. Set up automated AICc model selection (all-subsets regression using dredge) for each PD metric
pd_model_selection_list <- list()
for (resp in pd_response_cols) {
# Clean subset data for this specific model, including the site canopy metric
subset_data <- model_data %>%
select(all_of(c(resp, spectral_predictors, canopy_col))) %>%
drop_na()
# Fit global model with na.action = "na.fail" required for dredge
global_fit <- lm(
as.formula(paste0("`", resp, "` ~ ", paste(c(spectral_predictors, canopy_col), collapse = " + "))),
data = subset_data,
na.action = "na.fail"
)
# Perform automated AICc model selection
dredged_models <- dredge(global_fit, rank = "AICc")
# Extract the top-ranked model (lowest AICc)
best_model <- get.models(dredged_models, subset = 1)[[1]]
pd_model_selection_list[[resp]] <- list(
response     = resp,
all_dredged  = dredged_models,
best_model   = best_model,
best_summary = summary(best_model)
)
}
# 4. View the top-ranked model summary for Phylogenetic Synthesis Diversity (Beta_PD_qDTM)
print(pd_model_selection_list[["Beta_PD_qDTM"]]$best_summary)
# Optional: View relative variable importance weights across all subsets for Beta_PD_qDTM
# importance(pd_model_selection_list[["Beta_PD_qDTM"]]$all_dredged)
importance(pd_model_selection_list[["Beta_PD_qDTM"]]$all_dredged)
# Use sw() instead of importance() to get the sum of Akaike weights for each predictor variable
sw(pd_model_selection_list[["Beta_PD_qDTM"]]$all_dredged)
