y = "Phylogenetic Synthesis Diversity (Controlled)"
) +
theme_minimal(base_size = 11)
library(lavaan)
install.packages("lavaan")
library(lavaan)
# 1. Define your structural path model
# Path 1: Canopy cover is influenced by spectral entropy (Ht -> Canopy)
# Path 2: Phylogenetic diversity is influenced by both canopy cover AND spectral entropy (Canopy + Ht -> PD)
sem_model <- '
# Mediator model (does spectral diversity predict canopy cover?)
pct_visible_tree_cover ~ a * Ht_beta_BrightVectorNorm
# Response model (does PD depend on both canopy cover and spectral diversity?)
Beta_PD_qDTM ~ c_prime * Ht_beta_BrightVectorNorm + b * pct_visible_tree_cover
# Indirect (mediated) effect and Total effect calculations
indirect := a * b
total := c_prime + (a * b)
'
# 2. Fit the model using sem() with robust standard errors
fit_sem <- sem(sem_model, data = subset_data, estimator = "MLR")
# 3. View summary of paths, standard errors, and significance
summary(fit_sem, standardized = TRUE, fit.measures = TRUE)
library(lavaan)
# 1. Define your structural path model
# Path 1: Canopy cover is influenced by spectral entropy (Ht -> Canopy)
# Path 2: Phylogenetic diversity is influenced by both canopy cover AND spectral entropy (Canopy + Ht -> PD)
sem_model <- '
# Mediator model (does spectral diversity predict canopy cover?)
pct_visible_tree_cover ~ a * Ht_beta_BrightVectorNorm
# Response model (does PD depend on both canopy cover and spectral diversity?)
Beta_PD_qDTM ~ c_prime * Ht_beta_BrightVectorNorm + b * pct_visible_tree_cover
# Indirect (mediated) effect and Total effect calculations
indirect := a * b
total := c_prime + (a * b)
'
# 2. Fit the model using sem() with robust standard errors
fit_sem <- sem(sem_model, data = subset_data, estimator = "MLR")
# 3. View summary of paths, standard errors, and significance
summary(fit_sem, standardized = TRUE, fit.measures = TRUE)
# 1. Create a scaled version of subset_data so numerical optimization doesn't choke on large scales
scaled_data <- subset_data %>%
mutate(
Ht_scaled = scale(Ht_beta_BrightVectorNorm),
TreeCover_scaled = scale(pct_visible_tree_cover),
PD_scaled = scale(Beta_PD_qDTM)
)
# 2. Update the model formula using the scaled variables
sem_scaled_model <- '
# Mediator model
TreeCover_scaled ~ a * Ht_scaled
# Response model
PD_scaled ~ c_prime * Ht_scaled + b * TreeCover_scaled
# Indirect and total effects
indirect := a * b
total := c_prime + (a * b)
'
# 3. Fit with the scaled data
fit_sem_scaled <- sem(sem_scaled_model, data = scaled_data, estimator = "MLR")
# 4. View summary
summary(fit_sem_scaled, standardized = TRUE, fit.measures = TRUE)
