get_cor_matrix <- function(data, x_vars, y_vars) {
expand.grid(Metric = y_vars, Predictor = x_vars, stringsAsFactors = FALSE) %>%
rowwise() %>%
mutate(
test = list(tryCatch(cor.test(data[[Metric]], data[[Predictor]], use = "complete.obs"), error = function(e) NULL)),
r = if (!is.null(test)) test$estimate else NA_real_,
p.value = if (!is.null(test)) test$p.value else NA_real_
) %>%
ungroup() %>%
select(Metric, Predictor, r, p.value)
}
cor_results <- get_cor_matrix(dat, spectral_predictors, response_vars) %>%
mutate(
star = case_when(
p.value < 0.001 ~ "***",
p.value < 0.01  ~ "**",
p.value < 0.05  ~ "*",
TRUE            ~ ""
),
# Format label for text overlay (correlation value + stars)
label = paste0(sprintf("%.2f", r), star)
)
p_heatmap <- ggplot(cor_results, aes(x = Predictor, y = fct_rev(Metric), fill = r)) +
geom_tile(color = "white") +
geom_text(aes(label = label), size = 3.5, color = "black") +
scale_fill_gradient2(
low = "firebrick3",
mid = "white",
high = "forestgreen",
midpoint = 0,
limits = c(-1, 1),
name = "Pearson's r"
) +
labs(
title = "Correlations Between Spectral Predictors and Plant Metrics",
subtitle = "(* p < 0.05, ** p < 0.01, *** p < 0.001)",
x = "Spectral Predictor",
y = "Plant Biodiversity Metric"
) +
theme_minimal(base_size = 11) +
theme(
axis.text.x = element_text(angle = 45, hjust = 1, vjust = 1),
panel.grid.major = element_blank(),
legend.position = "right"
)
print(p_heatmap)
