addCoef.col = "black", number.cex = 0.7, mar = c(0,0,2,0),
title = "Plant Metric Correlations (All Dimensions)")
comparison_final <- comparison_final %>%
mutate(
FD_FDis_Gain_Value = TopDown_FD_FDis_m2_TopDown - TopDown_FD_FDis_m1_TopDown,
FD_FDis_Gain_Percent = (FD_FDis_Gain_Value / TopDown_FD_FDis_m1_TopDown) * 100,
FD_RaoQ_Gain_Value = TopDown_FD_RaoQ_m2_TopDown - TopDown_FD_RaoQ_m1_TopDown,
FD_RaoQ_Gain_Percent = (FD_RaoQ_Gain_Value / TopDown_FD_RaoQ_m1_TopDown) * 100
)
fdis_scatter <- ggplot(comparison_final, aes(x = TopDown_FD_FDis_m1_TopDown,
y = TopDown_FD_FDis_m2_TopDown)) +
geom_abline(slope = 1, intercept = 0, linetype = "dashed", color = "gray50") +
geom_point(aes(color = System_Type), size = 3, alpha = 0.7) +
geom_text_repel(aes(label = siteID), size = 2.5, max.overlaps = 20) +
theme_minimal() +
labs(title = "Functional Dispersion: Trait Space Expansion",
x = "FDis: Structural traits (LMA, N, C)",
y = "FDis: Full chemical traits (all 7)",
color = "Biome Type") +
theme(legend.position = "bottom", legend.text = element_text(size = 8))
library(ggrepel)
fdis_scatter <- ggplot(comparison_final, aes(x = TopDown_FD_FDis_m1_TopDown,
y = TopDown_FD_FDis_m2_TopDown)) +
geom_abline(slope = 1, intercept = 0, linetype = "dashed", color = "gray50") +
geom_point(aes(color = System_Type), size = 3, alpha = 0.7) +
geom_text_repel(aes(label = siteID), size = 2.5, max.overlaps = 20) +
theme_minimal() +
labs(title = "Functional Dispersion: Trait Space Expansion",
x = "FDis: Structural traits (LMA, N, C)",
y = "FDis: Full chemical traits (all 7)",
color = "Biome Type") +
theme(legend.position = "bottom", legend.text = element_text(size = 8))
fdis_scatter
fdis_gain_plot <- ggplot(comparison_final, aes(x = reorder(System_Type, FD_FDis_Gain_Percent, FUN = median),
y = FD_FDis_Gain_Percent, fill = System_Type)) +
geom_boxplot(alpha = 0.7, outlier.shape = NA) +
geom_jitter(width = 0.2, alpha = 0.5, size = 2) +
coord_flip() +
theme_minimal() +
labs(title = "Functional Dispersion Gain Across Biomes",
subtitle = "% increase in FDis when expanding from 3 to 7 traits",
x = "Biome Type",
y = "% Gain in FDis") +
theme(legend.position = "none")
fdis_gain_plot
rao_scatter <- ggplot(comparison_final, aes(x = TopDown_FD_RaoQ_m1_TopDown,
y = TopDown_FD_RaoQ_m2_TopDown)) +
geom_abline(slope = 1, intercept = 0, linetype = "dashed", color = "gray50") +
geom_point(aes(color = System_Type), size = 3, alpha = 0.7) +
geom_text_repel(aes(label = siteID), size = 2.5, max.overlaps = 20) +
theme_minimal() +
labs(title = "Rao's Quadratic Entropy: Trait Space Expansion",
x = "RaoQ: Structural traits (LMA, N, C)",
y = "RaoQ: Full chemical traits (all 7)",
color = "Biome Type") +
theme(legend.position = "bottom", legend.text = element_text(size = 8))
rao_scatter
beta_comp <- ggplot(comparison_final, aes(x = TopDown_FD_Beta_Dispersion_m1_TopDown,
y = TopDown_FD_Beta_Turnover_m1_TopDown)) +
geom_point(aes(color = System_Type), size = 3, alpha = 0.7) +
geom_text_repel(aes(label = siteID), size = 2.5, max.overlaps = 20) +
theme_minimal() +
labs(title = "Functional Beta Diversity: Dispersion vs. Turnover",
x = "Beta Dispersion (distance to centroid)",
y = "Beta Turnover (mean pairwise dissimilarity)",
color = "Biome Type") +
theme(legend.position = "bottom", legend.text = element_text(size = 8))
beta_comp
beta_disp_comp <- ggplot(comparison_final, aes(x = TopDown_FD_Beta_Dispersion_m1_TopDown,
y = TopDown_FD_Beta_Dispersion_m2_TopDown)) +
geom_abline(slope = 1, intercept = 0, linetype = "dashed", color = "gray50") +
geom_point(aes(color = System_Type), size = 3, alpha = 0.7) +
geom_text_repel(aes(label = siteID), size = 2.5, max.overlaps = 20) +
theme_minimal() +
labs(title = "Beta Dispersion: Model Comparison",
x = "Beta Dispersion (Model 1: LMA, N, C)",
y = "Beta Dispersion (Model 2: all 7 traits)",
color = "Biome Type") +
theme(legend.position = "bottom", legend.text = element_text(size = 8))
beta_disp_comp
