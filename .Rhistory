# 8. Plot Heatmap with cleanly structured component-matched labels
ggplot(plot_df, aes(x = Response, y = Predictor, fill = Correlation_sig)) +
geom_tile(color = "white") +
geom_text(aes(label = Significance), color = "black", size = 3) +
scale_fill_gradient2(low = "#2b5c8f", mid = "white", high = "#b2182b", midpoint = 0, limits = c(-1, 1), na.value = "grey95") +
theme_minimal(base_size = 11) +
theme(
axis.text.x = element_text(angle = 45, hjust = 1, vjust = 1),
axis.text.y = element_text(size = 9),
panel.grid = element_blank()
) +
labs(
title = "EMIT Spectral Diversity vs. NEON Plant Beta Diversity Components",
subtitle = "Non-significant pairs (p >= 0.05) greyed out; (* p<0.05, ** p<0.01, *** p<0.001)",
x = "NEON Plant Beta Response Metric",
y = "EMIT Spectral Predictor Metric",
fill = "Pearson r"
)
# 1. Get all predictor and response column names
predictor_cols <- grep("BrightVectorNorm$", names(emit_wide), value = TRUE)
response_cols  <- grep("^Beta_", names(neon), value = TRUE)
# 2. Run univariate linear models for every combination of predictor and response
model_grid <- expand.grid(
Predictor = predictor_cols,
Response = response_cols,
stringsAsFactors = FALSE
)
# 3. Fit models and extract key statistics (R-squared, p-value, slope, AIC)
results_list <- vector("list", nrow(model_grid))
for (i in seq_len(nrow(model_grid))) {
pred <- model_grid$Predictor[i]
resp <- model_grid$Response[i]
formula_str <- paste0("`", resp, "` ~ `", pred, "`")
fit <- lm(as.formula(formula_str), data = model_data)
fit_sum <- summary(fit)
# Extract p-value of the predictor
p_val <- if (nrow(fit_sum$coefficients) >= 2) fit_sum$coefficients[2, 4] else NA
results_list[[i]] <- data.frame(
Predictor   = pred,
Response    = resp,
R_squared   = fit_sum$r.squared,
Adj_R_sq    = fit_sum$adj.r.squared,
F_statistic = fit_sum$fstatistic[1],
p_value     = p_val,
AIC         = AIC(fit),
Slope       = if (nrow(fit_sum$coefficients) >= 2) fit_sum$coefficients[2, 1] else NA
)
}
univariate_models_df <- bind_rows(results_list) %>%
mutate(
Predictor = recode(Predictor, !!!spectral_labels),
Response  = recode(Response, !!!response_labels)
) %>%
arrange(desc(R_squared))
# 4. View the top-performing individual models ranked by R-squared
head(univariate_models_df, 15)
# 5. Optional: Quick heatmap of R-squared values for univariate models
ggplot(univariate_models_df, aes(x = Response, y = Predictor, fill = R_squared)) +
geom_tile(color = "white") +
geom_text(aes(label = ifelse(p_value < 0.05, sprintf("%.2f*", R_squared), sprintf("%.2f", R_squared))),
color = "black", size = 3) +
scale_fill_gradient(low = "white", high = "#b2182b", limits = c(0, 1)) +
theme_minimal(base_size = 11) +
theme(
axis.text.x = element_text(angle = 45, hjust = 1, vjust = 1),
axis.text.y = element_text(size = 9),
panel.grid = element_blank()
) +
labs(
title = "Univariate Model Fit ($R^2$) across EMIT Spectral Predictors and NEON Plant Metrics",
subtitle = "Asterisk (*) indicates significant relationships (p < 0.05)",
x = "NEON Plant Response Metric",
y = "EMIT Spectral Predictor Metric",
fill = "R-squared"
)
library(dplyr)
library(tidyr)
library(ggplot2)
# 1. Filter model results for only significant relationships (p < 0.05)
sig_models <- univariate_models_df %>%
filter(p_value < 0.05)
# 2. Re-create a long-format data frame of the original data to match the filtered models
# (We need the raw data points for the scatter plots)
pred_long <- model_data %>%
select(siteID, all_of(grep("BrightVectorNorm$", names(emit_wide), value = TRUE))) %>%
pivot_longer(-siteID, names_to = "Predictor", values_to = "Predictor_Val") %>%
mutate(Predictor = recode(Predictor, !!!spectral_labels))
resp_long <- model_data %>%
select(siteID, all_of(grep("^Beta_", names(neon), value = TRUE))) %>%
pivot_longer(-siteID, names_to = "Response", values_to = "Response_Val") %>%
mutate(Response = recode(Response, !!!response_labels))
plot_data_scatter <- inner_join(pred_long, resp_long, by = "siteID") %>%
inner_join(sig_models, by = c("Predictor", "Response")) %>%
mutate(
facet_label = paste0(Predictor, "\nvs.\n", Response),
stat_label = sprintf("R² = %.2f\np = %.3f", R_squared, p_value)
)
# 3. Generate faceted scatter plots with linear regression lines and stats
ggplot(plot_data_scatter, aes(x = Predictor_Val, y = Response_Val)) +
geom_point(color = "#2b5c8f", alpha = 0.7, size = 2) +
geom_smooth(method = "lm", color = "#b2182b", fill = "grey80", linewidth = 0.8) +
geom_text(
data = distinct(plot_data_scatter, facet_label, stat_label, Predictor, Response),
aes(x = -Inf, y = Inf, label = stat_label),
hjust = -0.1, vjust = 1.5, size = 3, color = "black", inherit.aes = FALSE
) +
facet_wrap(~ facet_label, scales = "free", ncol = 4) +
theme_minimal(base_size = 10) +
theme(
strip.text = element_text(size = 8, face = "bold"),
panel.grid.minor = element_blank()
) +
labs(
title = "Significant Univariate Relationships: EMIT Spectra vs. NEON Plant Metrics",
subtitle = "Showing OLS regression fits and performance stats for models where p < 0.05",
x = "EMIT Spectral Predictor Value",
y = "NEON Plant Response Value"
)
