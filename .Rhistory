library(glmnet)
library(dplyr)
run_lasso_permutation <- function(data, target_col, predictors, n_perms = 500) {
# 1. Prepare clean modeling frame
modeling_df <- data %>%
select(siteID, all_of(target_col), all_of(predictors)) %>%
na.omit()
x_mat <- as.matrix(modeling_df %>% select(all_of(predictors)))
y_vec <- modeling_df[[target_col]]
# 2. Calculate true (observed) cross-validated R2
set.seed(42)
cv_true <- cv.glmnet(x_mat, y_vec, alpha = 1, nfolds = 10)
y_pred_true <- as.vector(predict(cv_true, newx = x_mat, s = "lambda.min"))
r2_true <- as.numeric(cor(y_vec, y_pred_true)^2)
# 3. Run permutations
perm_r2s <- numeric(n_perms)
for (i in seq_len(n_perms)) {
# Shuffle the target vector while holding predictors fixed
y_permuted <- sample(y_vec)
cv_perm <- cv.glmnet(x_mat, y_permuted, alpha = 1, nfolds = 10)
y_pred_perm <- as.vector(predict(cv_perm, newx = x_mat, s = "lambda.min"))
# Handle cases where variance collapses to zero in null model
cor_val <- cor(y_permuted, y_pred_perm)
perm_r2s[i] <- ifelse(is.na(cor_val), 0, as.numeric(cor_val^2))
}
# 4. Calculate empirical p-value
# p-value is the proportion of permuted R2s greater than or equal to the true R2
p_val <- (sum(perm_r2s >= r2_true) + 1) / (n_perms + 1)
cat(sprintf("Target: %s\n", target_col))
cat(sprintf("Observed R²: %.4f\n", r2_true))
cat(sprintf("Empirical p-value (from %d permutations): %.4f\n", n_perms, p_val))
return(list(observed_r2 = r2_true, perm_r2s = perm_r2s, p_value = p_val))
}
# Example usage for one of your metrics:
# perm_results <- run_lasso_permutation(combined_data, "PD.qDTM.beta_scaled", predictor_cols, n_perms = 500)
perm_results <- run_lasso_permutation(combined_data, "PD.qDTM.beta_scaled", predictor_cols, n_perms = 500)
perm_results <- run_lasso_permutation(combined_data, "PD.qDTM.beta_unscaled", predictor_cols, n_perms = 500)
library(dplyr)
library(glmnet)
# 1. Filter predictor columns to focus strictly on dispersion and evenness metrics
dispersion_evenness_cols <- predictor_cols[
grepl("FHD|M|qHt|qEt|qDT|qDTM", predictor_cols) &
!grepl("cover|PAI", predictor_cols) # Optional: drop raw cover/PAI if testing pure heterogeneity
]
# Or if you want to include cover/PAI dispersion variants, keep them explicitly:
# dispersion_evenness_cols <- predictor_cols[grepl("FHD|qHt|qEt|qDT|qDTM|M", predictor_cols)]
# 2. Re-run your permutation test function with the restricted feature set
restricted_perm_results <- run_lasso_permutation(
data = combined_data,
target_col = "PD.qDTM.beta_scaled",
predictors = dispersion_evenness_cols,
n_perms = 500
)
# Filter predictor columns to focus on dispersion and evenness, explicitly dropping qDTM and qDT
dispersion_evenness_cols <- predictor_cols[
grepl("FHD|M|qHt|qEt", predictor_cols) &
!grepl("qDTM|qDT", predictor_cols)
]
# Re-run the permutation test with the restricted feature space
restricted_perm_results <- run_lasso_permutation(
data = combined_data,
target_col = "PD.qDTM.beta_scaled", # (or update to match whichever metric you are actively testing)
predictors = dispersion_evenness_cols,
n_perms = 500
)
# Fit a targeted multiple linear regression model
mlr_model <- lm(PD.qDTM.beta_scaled ~ qDTM + FHD_qDTM_norm, data = combined_data)
# View the standard summary with traditional p-values and R-squared
summary(mlr_model)
# Check diagnostic plots to ensure residuals look reasonable
par(mfrow = c(2, 2))
plot(mlr_model)
par(mfrow = c(1, 1))
library(brms)
install.packages("brms")
library(brms)
# Fit a Bayesian linear regression model with weakly informative priors
bayesian_model <- brm(
formula = PD.qDTM.beta_scaled ~ qDTM,
data = combined_data,
family = gaussian(),
prior = set_prior("normal(0, 10)", class = "b"), # Weakly informative regularizing prior
chains = 4,
iter = 4000,
warmup = 1000,
seed = 42
)
# Clear any lingering invalid sink connections
while(sink.number() > 0) sink(NULL)
# Then re-run your brms model call
bayesian_model <- brm(
formula = PD.qDTM.beta_scaled ~ qDTM,
data = combined_data,
family = gaussian(),
prior = set_prior("normal(0, 10)", class = "b"),
chains = 4,
iter = 4000,
warmup = 1000,
seed = 42
)
