visreg(top_model, "Ht_beta_BrightVectorNorm",
gg = TRUE,
fill = list(fill = "grey80"),
line = list(color = "#b2182b"),
points = list(color = "#b2182b", pch = 16, alpha = 0.7)) +
labs(
