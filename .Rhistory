response_vars <- c("Alpha_FD_qDTM", "Beta_FD_qDTM", "Alpha_PD_qDTM", "Beta_PD_qDTM",
"Alpha_Richness_FD", "Total_Richness_FD", "Alpha_Dispersion_FD",
"Beta_Dispersion_FD", "Alpha_Evenness_FD", "Beta_Evenness_FD",
"Alpha_Richness_PD", "Total_Richness_PD", "Alpha_Dispersion_PD",
"Beta_Dispersion_PD", "Alpha_Evenness_PD", "Beta_Evenness_PD")
# Filter response variables to only those actually present in your dataframe 'dat'
response_vars <- intersect(response_vars, names(dat))
# 2. Define the set of raw spectral predictors you want to test
predictors <- c("raw_dispersion", "raw_evenness", "raw_sum_squares")
# 3. Create a function to run stepAIC on a given response variable
run_stepwise_aic <- function(resp, data) {
# Build formula dynamically using all three predictors
formula_str <- paste(resp, "~", paste(predictors, collapse = " + "))
# Check if all required columns exist and have non-missing data
vars_needed <- c(resp, predictors)
sub_dat <- data %>% select(any_of(vars_needed)) %>% drop_na()
if (nrow(sub_dat) < 10) return(NULL) # Skip if too few observations
# Fit full model
full_mod <- lm(as.formula(formula_str), data = sub_dat, na.action = na.exclude)
# Run stepAIC quietly (trace = FALSE)
best_mod <- stepAIC(full_mod, direction = "both", trace = FALSE)
return(best_mod)
}
# 4. Run across all response variables and store models
all_best_models <- map(response_vars, ~run_stepwise_aic(., dat))
library(tidyverse)
library(MASS)
library(broom)
# -------------------------------------------------------------------------------------
# Automated Stepwise AIC Selection Across All Response Variables & Spectral Metrics (Fixed)
# -------------------------------------------------------------------------------------
response_vars <- c("Alpha_FD_qDTM", "Beta_FD_qDTM", "Alpha_PD_qDTM", "Beta_PD_qDTM",
"Alpha_Richness_FD", "Total_Richness_FD", "Alpha_Dispersion_FD",
"Beta_Dispersion_FD", "Alpha_Evenness_FD", "Beta_Evenness_FD",
"Alpha_Richness_PD", "Total_Richness_PD", "Alpha_Dispersion_PD",
"Beta_Dispersion_PD", "Alpha_Evenness_PD", "Beta_Evenness_PD")
response_vars <- intersect(response_vars, names(dat))
predictors <- c("raw_dispersion", "raw_evenness", "raw_sum_squares")
run_stepwise_aic <- function(resp, data) {
formula_str <- paste(resp, "~", paste(predictors, collapse = " + "))
vars_needed <- c(resp, predictors)
# Fix: use base subset or dplyr select correctly depending on tidyverse version
sub_dat <- data[, intersect(vars_needed, names(data))]
sub_dat <- na.omit(sub_dat)
if (nrow(sub_dat) < 10) return(NULL)
full_mod <- lm(as.formula(formula_str), data = sub_dat, na.action = na.exclude)
best_mod <- stepAIC(full_mod, direction = "both", trace = FALSE)
return(best_mod)
}
all_best_models <- map(response_vars, ~run_stepwise_aic(., dat))
names(all_best_models) <- response_vars
all_best_models <- compact(all_best_models)
non_null_models <- keep(all_best_models, function(mod) {
length(coef(mod)) > 1
})
if (length(non_null_models) > 0) {
non_null_summaries <- map_dfr(non_null_models, ~tidy(.), .id = "Response_Variable")
non_null_glances <- map_dfr(non_null_models, ~glance(.), .id = "Response_Variable")
print("--- Summary of Terms for Significant Non-Null Models ---")
print(non_null_summaries)
print("--- Performance Metrics for Significant Non-Null Models ---")
print(non_null_glances %>% select(Response_Variable, r.squared, adj.r.squared, p.value, AIC))
} else {
print("No models beat the null model under stepAIC selection.")
}
# Expand the print limit for tibbles to show all rows
print(non_null_summaries, n = Inf)
# Also check the performance metrics for all of them without truncation
print(non_null_glances %>% select(Response_Variable, r.squared, adj.r.squared, p.value, AIC), n = Inf)
library(tidyverse)
# -------------------------------------------------------------------------------------
# Coefficient Heatmap Across All Selected Stepwise Models
# -------------------------------------------------------------------------------------
# 1. Format data: remove intercepts and ensure a complete grid of responses x predictors
all_predictors <- c("raw_dispersion", "raw_evenness", "raw_sum_squares")
all_responses <- unique(non_null_summaries$Response_Variable)
heatmap_data <- non_null_summaries %>%
filter(term != "(Intercept)") %>%
complete(Response_Variable = all_responses, term = all_predictors,
fill = list(estimate = 0, p.value = 1, std.error = NA)) %>%
mutate(
# Add significance asterisks for visual cue
signif = case_when(
p.value < 0.001 ~ "***",
p.value < 0.01  ~ "**",
p.value < 0.05  ~ "*",
p.value < 0.1   ~ ".",
TRUE ~ ""
),
# Set estimate to NA for predictors dropped by stepAIC so they render cleanly as gray/empty
display_estimate = ifelse(p.value == 1 & estimate == 0, NA, estimate)
)
# 2. Build heatmap visualization
p_heatmap <- ggplot(heatmap_data, aes(x = term, y = Response_Variable, fill = display_estimate)) +
geom_tile(color = "white", linewidth = 0.8) +
geom_text(aes(label = ifelse(is.na(display_estimate), "", paste0(round(display_estimate, 2), signif))),
size = 3.2, color = "gray10", fontface = "bold") +
scale_fill_gradient2(
low = "firebrick3",
mid = "white",
high = "forestgreen",
midpoint = 0,
na.value = "gray92",
name = "Coefficient\nEstimate"
) +
labs(
title = "Spectral Predictor Effects Across Biodiversity Metrics",
subtitle = "Heatmap of stepAIC model coefficients (* p < 0.05, ** p < 0.01, *** p < 0.001; gray = dropped)",
x = "Raw Spectral Predictor",
y = "Response Variable"
) +
theme_minimal(base_size = 11) +
theme(
plot.title = element_text(face = "bold", size = 12),
axis.text.x = element_text(angle = 25, hjust = 1, face = "bold"),
axis.text.y = element_text(face = "bold"),
panel.grid = element_blank(),
legend.position = "right"
)
print(p_heatmap)
